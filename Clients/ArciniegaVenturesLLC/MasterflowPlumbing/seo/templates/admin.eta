<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="<%= it.sitemapBrandLogoHref %>">
  <title><%= it.meta.title %></title>
  <meta name="description" content="<%= it.meta.description %>">
  <meta name="robots" content="<%= it.meta.robots %>">
  <link rel="canonical" href="<%= it.meta.canonical %>">
  <link rel="author" href="<%= it.maintainer.url %>">
  <meta property="og:title" content="<%= it.meta.title %>">
  <meta property="og:description" content="<%= it.meta.description %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= it.meta.canonical %>">
  <meta property="og:image" content="<%= it.absoluteMedia(it.business.media.social || it.business.media.hero) %>">
  <meta name="theme-color" content="#050608">
  <% it.schema.forEach((node) => { %>
  <script type="application/ld+json"><%~ JSON.stringify(node) %></script>
  <% }) %>
  <style>
    @font-face {
      font-family: "Squarish Sans";
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url("<%= it.sitemapBrandFontHref %>") format("woff2");
    }
    :root {
      --black: #050608;
      --white: #ffffff;
      --page: #f5f8ff;
      --peach: #fff0ec;
      --mint: #e7fbf9;
      --blue: #2b71eb;
      --teal: #11c5b5;
      --ink: #0d2247;
      --muted: #48618c;
      --line: #c5daff;
    }
    * { box-sizing: border-box; }
    body {
      background: var(--page);
      color: var(--ink);
      font-family: "Squarish Sans", "Arial Narrow", Arial, sans-serif;
      letter-spacing: 0;
      margin: 0;
      min-height: 100vh;
    }
    a { color: inherit; }
    .shell { margin: 0 auto; max-width: 1180px; padding: 28px 20px 56px; }
    .brand-panel {
      align-items: center;
      background: var(--black);
      color: var(--white);
      display: flex;
      gap: 22px;
      justify-content: space-between;
      min-height: 148px;
      padding: 22px 26px;
    }
    .brand-lockup { align-items: center; display: flex; gap: 18px; min-width: 0; }
    .logo-frame {
      align-items: center;
      background: var(--white);
      display: flex;
      flex: 0 0 154px;
      height: 92px;
      justify-content: center;
      overflow: hidden;
    }
    .logo-frame img { display: block; height: 130px; object-fit: contain; width: 154px; }
    .brand-copy { min-width: 0; }
    .brand-copy strong { display: block; font-size: 1.3rem; font-weight: 400; }
    .brand-copy span { color: rgba(255,255,255,.66); display: block; margin-top: 7px; }
    .brand-link {
      border: 1px solid rgba(255,255,255,.34);
      color: var(--white);
      padding: 11px 14px;
      text-decoration: none;
      white-space: nowrap;
    }
    .brand-link:hover { background: var(--white); color: var(--black); }
    .intro {
      background: var(--white);
      border: 1px solid var(--line);
      border-top: 4px solid var(--blue);
      padding: 32px 28px;
    }
    .eyebrow { color: var(--blue); display: block; font-size: .84rem; margin-bottom: 10px; text-transform: uppercase; }
    h1, h2, h3 { color: var(--black); font-weight: 400; }
    h1 { font-size: clamp(2.1rem, 6vw, 4.5rem); line-height: 1; margin: 0; max-width: 880px; }
    h2 { font-size: clamp(1.55rem, 3vw, 2.35rem); line-height: 1.08; margin: 0 0 14px; }
    h3 { font-size: 1.15rem; margin: 0 0 10px; }
    p { color: var(--muted); line-height: 1.65; }
    .intro p { font-size: 1.05rem; margin: 16px 0 0; max-width: 800px; }
    .status-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 18px;
    }
    .status-item { background: var(--white); border: 1px solid var(--line); border-right: 0; padding: 18px; }
    .status-item:last-child { border-right: 1px solid var(--line); }
    .status-item span { color: var(--blue); display: block; font-size: .76rem; margin-bottom: 8px; text-transform: uppercase; }
    .status-item strong { color: var(--black); display: block; font-weight: 400; overflow-wrap: anywhere; }
    main { display: grid; gap: 0; margin-top: 18px; }
    main section { border-top: 1px solid var(--line); padding: 34px 2px; }
    main section:first-child { border-top: 0; }
    .admin-grid { display: grid; gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .admin-card { background: var(--page); border-left: 5px solid var(--teal); padding: 20px; }
    .admin-card:nth-child(2) { background: var(--peach); border-left-color: var(--blue); }
    .admin-card p { margin: 0; }
    .action-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
    .action-row a { border: 1px solid var(--black); color: var(--black); padding: 11px 14px; text-decoration: none; }
    .action-row a:first-child { background: var(--black); color: var(--white); }
    .action-row a:hover { background: var(--blue); border-color: var(--blue); color: var(--white); }
    footer {
      align-items: center;
      border-top: 1px solid var(--line);
      color: var(--muted);
      display: flex;
      gap: 14px;
      justify-content: space-between;
      margin-top: 24px;
      padding: 20px 2px 0;
    }
    footer a { color: var(--black); }
    @media (max-width: 780px) {
      .shell { padding: 0 0 38px; }
      .brand-panel { align-items: flex-start; flex-direction: column; min-height: 0; }
      .brand-lockup { align-items: flex-start; flex-direction: column; }
      .logo-frame { flex-basis: auto; }
      .brand-link { white-space: normal; }
      .intro { padding: 24px 20px; }
      main section { padding: 28px 20px; }
      .status-grid, .admin-grid { grid-template-columns: 1fr; }
      .status-item { border-bottom: 0; border-right: 1px solid var(--line); }
      .status-item:last-child { border-bottom: 1px solid var(--line); }
      footer { align-items: flex-start; flex-direction: column; padding: 20px; }
    }
  </style>
</head>
<body>
  <div class="shell">
    <header class="brand-panel">
      <div class="brand-lockup">
        <div class="logo-frame">
          <img src="<%= it.sitemapBrandLogoHref %>" alt="Valen Systems logo" width="154" height="92">
        </div>
        <div class="brand-copy">
          <strong>Valen Systems</strong>
          <span>Client infrastructure control record</span>
        </div>
      </div>
      <a class="brand-link" href="<%= it.maintainer.url %>" rel="author noopener">Visit <%= it.maintainer.domain %></a>
    </header>

    <section class="intro">
      <span class="eyebrow"><%= it.eyebrow %></span>
      <h1><%= it.h1 %></h1>
      <p><%= it.heroCopy %></p>
    </section>

    <aside class="status-grid" aria-label="Masterflow website infrastructure status">
      <div class="status-item"><span>Canonical site</span><strong><%= it.business.primary_domain.replace("https://", "") %></strong></div>
      <div class="status-item"><span>Content origin</span><strong>clients.valen-systems.com</strong></div>
      <div class="status-item"><span>Contractor</span><strong><%= it.licenseDisplay %></strong></div>
      <div class="status-item"><span>Masterflow service</span><strong><%= it.business.phone_display %></strong></div>
    </aside>

    <main>
      <%~ it.body %>
    </main>

    <footer>
      <span>Masterflow Plumbing website record</span>
      <span>Created and maintained by <a href="<%= it.maintainer.url %>" rel="author noopener"><%= it.maintainer.name %></a></span>
    </footer>
  </div>
</body>
</html>
