<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="<%= it.sitemapBrandLogoHref %>">
  <title><%= it.meta.title %></title>
  <meta name="description" content="<%= it.meta.description %>">
  <meta name="robots" content="<%= it.meta.robots %>">
  <link rel="canonical" href="<%= it.meta.canonical %>">
  <link rel="author" href="<%= it.maintainer.url %>">
  <meta name="theme-color" content="#050608">
  <% it.schema.forEach((node) => { %>
  <script type="application/ld+json"><%~ JSON.stringify(node) %></script>
  <% }) %>
  <style>
    @font-face {
      font-family: "Squarish Sans";
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url("<%= it.sitemapBrandFontHref %>") format("woff2");
    }
    :root {
      --black: #050608;
      --white: #ffffff;
      --blue: #2b71eb;
      --ink: #0d2247;
      --muted: #48618c;
    }
    * { box-sizing: border-box; }
    body {
      background: var(--white);
      color: var(--ink);
      font-family: "Squarish Sans", "Arial Narrow", Arial, sans-serif;
      letter-spacing: 0;
      margin: 0;
    }
    main {
      display: grid;
      min-height: 100svh;
      padding: 32px 20px;
      place-items: center;
    }
    .accreditation {
      max-width: 680px;
      text-align: center;
    }
    img {
      display: block;
      height: auto;
      margin: 0 auto 28px;
      max-width: 210px;
      width: 52vw;
    }
    .eyebrow {
      color: var(--blue);
      display: block;
      font-size: .82rem;
      margin-bottom: 12px;
      text-transform: uppercase;
    }
    h1 {
      color: var(--black);
      font-size: clamp(2rem, 7vw, 4.5rem);
      font-weight: 400;
      line-height: 1;
      margin: 0 0 18px;
    }
    p {
      color: var(--muted);
      font-size: clamp(1.05rem, 2.4vw, 1.35rem);
      line-height: 1.55;
      margin: 0;
    }
    a {
      color: var(--ink);
      text-decoration-color: var(--blue);
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }
    a:hover { color: var(--blue); }
  </style>
</head>
<body>
  <main>
    <section class="accreditation" aria-labelledby="accreditation-title">
      <img src="<%= it.sitemapBrandLogoHref %>" alt="Valen Systems logo" width="210" height="126">
      <span class="eyebrow">Website accreditation</span>
      <h1 id="accreditation-title">Masterflow Plumbing</h1>
      <%~ it.body %>
    </section>
  </main>
</body>
</html>
