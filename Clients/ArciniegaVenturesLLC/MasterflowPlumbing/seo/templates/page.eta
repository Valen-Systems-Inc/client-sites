<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.meta.title %></title>
  <meta name="description" content="<%= it.meta.description %>">
  <meta name="robots" content="<%= it.meta.robots %>">
  <link rel="canonical" href="<%= it.meta.canonical %>">
  <meta property="og:title" content="<%= it.meta.title %>">
  <meta property="og:description" content="<%= it.meta.description %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= it.meta.canonical %>">
  <meta property="og:image" content="<%= it.absoluteMedia(it.business.media.hero) %>">
  <meta name="theme-color" content="<%= it.business.brand.primary %>">
  <% it.schema.forEach((node) => { %>
  <script type="application/ld+json"><%~ JSON.stringify(node) %></script>
  <% }) %>
  <style>
    :root {
      --navy: #1E3A5F;
      --blue: #2F6EA5;
      --orange: #FF6B35;
      --ink: #122033;
      --muted: #5F6D7D;
      --line: #DCE4ED;
      --soft: #F5F8FB;
      --mint: #DDF7EA;
      --white: #FFFFFF;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--soft);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.55;
    }
    a { color: inherit; }
    .topbar {
      background: rgba(255,255,255,.96);
      border-bottom: 1px solid var(--line);
      position: sticky;
      top: 0;
      z-index: 20;
    }
    .nav {
      align-items: center;
      display: flex;
      gap: 18px;
      justify-content: space-between;
      margin: 0 auto;
      max-width: 1160px;
      padding: 12px 18px;
    }
    .brand {
      color: var(--navy);
      font-weight: 900;
      letter-spacing: 0;
      text-decoration: none;
    }
    .nav-actions {
      align-items: center;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    .nav-actions a {
      color: var(--muted);
      font-size: .9rem;
      font-weight: 800;
      text-decoration: none;
    }
    .call {
      align-items: center;
      background: var(--orange);
      border-radius: 999px;
      color: var(--white) !important;
      display: inline-flex;
      min-height: 42px;
      padding: 10px 16px;
      text-decoration: none;
      white-space: nowrap;
    }
    .hero {
      background:
        linear-gradient(90deg, rgba(18,32,51,.9), rgba(18,32,51,.62), rgba(18,32,51,.18)),
        url("<%= it.business.media.hero %>") center/cover;
      color: var(--white);
      min-height: 74vh;
      padding: 92px 18px 44px;
      position: relative;
    }
    .hero-inner {
      margin: 0 auto;
      max-width: 1160px;
    }
    .eyebrow {
      color: #FFD1C0;
      display: block;
      font-size: .82rem;
      font-weight: 900;
      letter-spacing: .08em;
      margin-bottom: 14px;
      text-transform: uppercase;
    }
    h1 {
      font-size: clamp(2.4rem, 7vw, 5.8rem);
      letter-spacing: 0;
      line-height: .95;
      margin: 0;
      max-width: 980px;
    }
    .hero p {
      font-size: clamp(1.05rem, 2vw, 1.35rem);
      max-width: 720px;
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 24px;
    }
    .button {
      align-items: center;
      border: 2px solid rgba(255,255,255,.72);
      border-radius: 999px;
      display: inline-flex;
      font-weight: 900;
      min-height: 48px;
      padding: 12px 18px;
      text-decoration: none;
    }
    .button.primary { background: var(--orange); border-color: var(--orange); color: var(--white); }
    .button.secondary { color: var(--white); }
    .proof {
      background: var(--white);
      border-bottom: 1px solid var(--line);
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin: 0 auto;
      max-width: 1160px;
      transform: translateY(-26px);
    }
    .proof div {
      border-right: 1px solid var(--line);
      padding: 18px;
    }
    .proof div:last-child { border-right: 0; }
    .proof strong {
      color: var(--navy);
      display: block;
      font-size: 1.1rem;
    }
    .proof span { color: var(--muted); font-size: .92rem; }
    main section {
      margin: 0 auto;
      max-width: 1160px;
      padding: 48px 18px;
    }
    .section-kicker {
      color: var(--orange);
      display: block;
      font-size: .8rem;
      font-weight: 900;
      letter-spacing: .08em;
      margin-bottom: 10px;
      text-transform: uppercase;
    }
    h2 {
      color: var(--navy);
      font-size: clamp(1.8rem, 4vw, 3.3rem);
      letter-spacing: 0;
      line-height: 1.03;
      margin: 0 0 16px;
      max-width: 880px;
    }
    .lede { color: var(--muted); font-size: 1.08rem; max-width: 820px; }
    .grid {
      display: grid;
      gap: 16px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 22px;
    }
    .card {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 22px;
    }
    .card h3 { color: var(--navy); margin: 0 0 8px; }
    .card p { color: var(--muted); margin: 0; }
    .local-panel {
      background: var(--navy);
      color: var(--white);
      display: grid;
      gap: 22px;
      grid-template-columns: 1.15fr .85fr;
      max-width: none;
      padding: 56px max(18px, calc((100vw - 1160px) / 2));
    }
    .local-panel h2, .local-panel .section-kicker { color: var(--white); }
    .local-panel .section-kicker { color: #FFD1C0; }
    .local-panel p { color: rgba(255,255,255,.84); }
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 16px;
    }
    .chips span {
      background: rgba(255,255,255,.12);
      border: 1px solid rgba(255,255,255,.24);
      border-radius: 999px;
      color: var(--white);
      font-size: .9rem;
      font-weight: 800;
      padding: 8px 11px;
    }
    .media-proof {
      aspect-ratio: 4 / 3;
      background: var(--soft);
      border-radius: 8px;
      overflow: hidden;
    }
    .media-proof img {
      height: 100%;
      object-fit: cover;
      width: 100%;
    }
    .process {
      counter-reset: step;
      display: grid;
      gap: 14px;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .step {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 18px;
    }
    .step:before {
      color: var(--orange);
      content: counter(step, decimal-leading-zero);
      counter-increment: step;
      display: block;
      font-weight: 900;
      margin-bottom: 10px;
    }
    .related-list {
      display: grid;
      gap: 10px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 18px;
    }
    .related-list a {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--navy);
      font-weight: 900;
      padding: 14px;
      text-decoration: none;
    }
    details {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 8px;
      margin-top: 10px;
      padding: 16px 18px;
    }
    summary {
      color: var(--navy);
      cursor: pointer;
      font-weight: 900;
    }
    details p { color: var(--muted); margin-bottom: 0; }
    .cta {
      background: linear-gradient(135deg, var(--navy), #174E73);
      color: var(--white);
      max-width: none;
      padding: 54px max(18px, calc((100vw - 1160px) / 2));
    }
    .cta h2 { color: var(--white); }
    .footer {
      background: #0D1928;
      color: rgba(255,255,255,.78);
      padding: 34px 18px;
    }
    .footer-inner {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      justify-content: space-between;
      margin: 0 auto;
      max-width: 1160px;
    }
    .footer a { color: var(--white); }
    @media (max-width: 820px) {
      .nav { align-items: flex-start; flex-direction: column; }
      .proof, .grid, .process, .local-panel, .related-list { grid-template-columns: 1fr; }
      .proof { transform: none; }
      .proof div { border-right: 0; border-bottom: 1px solid var(--line); }
      .hero { min-height: 70vh; padding-top: 64px; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <nav class="nav" aria-label="Masterflow localized navigation">
      <a class="brand" href="<%= it.prefix %>/">Masterflow Plumbing & Rooter</a>
      <div class="nav-actions">
        <a href="<%= it.prefix %>/locations/<%= it.primaryMarket.slug %>/">Corona hub</a>
        <a href="<%= it.prefix %>/services/<%= it.primaryService.slug %>/">Services</a>
        <a class="call" href="tel:9516127912">Call <%= it.business.phone_display %></a>
      </div>
    </nav>
  </header>
  <section class="hero">
    <div class="hero-inner">
      <span class="eyebrow"><%= it.eyebrow %></span>
      <h1><%= it.h1 %></h1>
      <p><%= it.heroCopy %></p>
      <div class="hero-actions">
        <a class="button primary" href="tel:9516127912">Call <%= it.business.phone_display %></a>
        <a class="button secondary" href="#local-proof">See local fit</a>
      </div>
    </div>
  </section>
  <aside class="proof" aria-label="Masterflow proof">
    <div><strong>Corona first</strong><span>Main service hub with regional dispatch.</span></div>
    <div><strong>24/7</strong><span>Emergency plumbing and drain calls.</span></div>
    <div><strong><%= it.business.license_no %></strong><span>California plumbing contractor proof.</span></div>
    <div><strong>Direct line</strong><span><%= it.business.phone_display %></span></div>
  </aside>
  <main>
    <%~ it.body %>
  </main>
  <section class="cta">
    <span class="section-kicker">Call Masterflow</span>
    <h2>Need a licensed plumber near <%= it.locationLabel %>?</h2>
    <p>Call <%= it.business.phone_display %> for emergency plumbing, drains, water heaters, sewer lines, leaks, and repair planning across the Corona-centered service area.</p>
    <a class="button primary" href="tel:9516127912">Call now</a>
  </section>
  <footer class="footer">
    <div class="footer-inner">
      <div>
        <strong>Masterflow Plumbing & Rooter</strong><br>
        <span><%= it.business.license_no %> | <%= it.business.phone_display %></span>
      </div>
      <div>
        <a href="/">Main site</a> |
        <a href="/privacy.html">Privacy</a> |
        <a href="/terms.html">Terms</a> |
        <a href="<%= it.prefix %>/sitemap.xml">SEO sitemap</a>
      </div>
    </div>
  </footer>
</body>
</html>
