{
  "name": "masterflow-plumbing-local-seo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "masterflowRelease": "mflow-v.1.1.0",
  "description": "Localized static SEO engine for Masterflow Plumbing client-site artifacts.",
  "scripts": {
    "seo:enrich": "node seo/engine/enrich-regions.mjs",
    "seo:build": "node seo/engine/build.mjs --full --out=seo-preview",
    "seo:build-production": "node seo/engine/build.mjs --production --full",
    "seo:build-commercial": "node seo/engine/build.mjs --variant=commercial --full --out=commercial --route-prefix=/commercial",
    "seo:build-commercial-production": "node seo/engine/build.mjs --variant=commercial --full --indexable --out=commercial-production --route-prefix=/commercial",
    "seo:preview": "node seo/engine/build.mjs --full --out=seo-preview",
    "seo:preview-sample": "node seo/engine/build.mjs --limit-markets=12 --limit-services=8 --out=seo-preview",
    "seo:serve": "node seo/engine/server.mjs",
    "seo:test": "node seo/engine/test.mjs",
    "seo:intel": "node seo/engine/collect-search-intel.mjs",
    "seo:intel:google": "node seo/engine/collect-search-intel.mjs --provider=openserp --serp-engine=google --goal-queries --limit-results=10",
    "seo:competitor-map": "node seo/engine/map-competitors.mjs",
    "seo:keyword-universe": "node seo/engine/build-keyword-universe.mjs",
    "seo:queue": "node seo/engine/build-microsite-queue.mjs",
    "seo:deploy-preview": "node seo/engine/deploy-r2-preview.mjs --prefix=seo-preview",
    "seo:deploy-production:media": "node seo/engine/deploy-r2-preview.mjs --root=seo-production --target-prefix= --media-only",
    "seo:deploy-production": "node seo/engine/deploy-r2-preview.mjs --root=seo-production --target-prefix= --skip-media --exclude-sitemaps",
    "seo:deploy-production:sitemaps": "node seo/engine/deploy-r2-preview.mjs --root=seo-production --target-prefix=_control/sitemaps --skip-media --sitemap-only",
    "seo:deploy-commercial-production": "node seo/engine/deploy-r2-preview.mjs --root=commercial-production --target-prefix=commercial --skip-media --exclude-sitemaps",
    "seo:deploy-commercial-production:sitemaps": "node seo/engine/deploy-r2-preview.mjs --root=commercial-production --target-prefix=_control/sitemaps/commercial --skip-media --sitemap-only",
    "seo:migrate-valen-cdn": "node seo/engine/migrate-r2-to-valen-clients.mjs",
    "seo:migrate-valen-cdn:apply": "node seo/engine/migrate-r2-to-valen-clients.mjs --apply",
    "seo:migrate-valen-cdn:verify": "node seo/engine/migrate-r2-to-valen-clients.mjs --verify-only",
    "seo:archive-source-cdn:apply": "node seo/engine/migrate-r2-to-valen-clients.mjs --apply --destination-prefix=masterflow-plumbing/_rollback/masterflowplumbing-cdn-2026-07-16 --destination-public-base=https://clients.valen-systems.com/masterflow-plumbing/_rollback/masterflowplumbing-cdn-2026-07-16 --report-file=valen-clients-cdn-rollback-migration.json",
    "seo:archive-source-cdn:verify": "node seo/engine/migrate-r2-to-valen-clients.mjs --verify-only --destination-prefix=masterflow-plumbing/_rollback/masterflowplumbing-cdn-2026-07-16 --destination-public-base=https://clients.valen-systems.com/masterflow-plumbing/_rollback/masterflowplumbing-cdn-2026-07-16 --report-file=valen-clients-cdn-rollback-migration.json",
    "seo:legacy-cdn:plan-purge": "node seo/engine/purge-legacy-r2.mjs",
    "seo:legacy-cdn:purge": "node seo/engine/purge-legacy-r2.mjs --apply --confirm=EMPTY-masterflowplumbing-cdn",
    "seo:indexnow:plan": "node seo/engine/indexnow.mjs",
    "seo:indexnow:submit": "node seo/engine/indexnow.mjs --submit",
    "seo:indexnow:key:plan": "node seo/engine/deploy-indexnow-key.mjs",
    "seo:indexnow:key:deploy": "node seo/engine/deploy-indexnow-key.mjs --apply",
    "seo:indexnow:test": "node --test seo/engine/indexnow.test.mjs",
    "seo:legacy-cdn:test": "node --test seo/engine/purge-legacy-r2.test.mjs",
    "control-plane:test": "npm run cdn-proxy:test && npm run seo:indexnow:test && npm run seo:legacy-cdn:test",
    "cdn-proxy:test": "node --test cdn-proxy-worker/src/worker.test.mjs",
    "cdn-proxy:deploy": "npx --yes wrangler@4.107.0 deploy --config cdn-proxy-worker/wrangler.toml",
    "seo:verify-production": "node seo/engine/verify-live-release.mjs",
    "seo:verify-commercial-production": "node seo/engine/verify-live-release.mjs --variant=commercial",
    "seo:test-commercial": "node seo/engine/test-commercial.mjs",
    "seo:publish-audos": "node seo/engine/publish-audos-engine.mjs",
    "seo:stage-microsite": "node seo/engine/stage-audos-microsite.mjs",
    "site-api:test": "node review-worker/src/worker.test.mjs",
    "site-api:migrate": "npx --yes wrangler@4.107.0 d1 migrations apply masterflow_reviews --remote --config review-worker/wrangler.toml",
    "site-api:deploy": "npx --yes wrangler@4.107.0 deploy --config review-worker/wrangler.toml",
    "reviews:list-pending": "node review-worker/scripts/moderate-reviews.mjs list",
    "reviews:approve": "node review-worker/scripts/moderate-reviews.mjs approve",
    "reviews:reject": "node review-worker/scripts/moderate-reviews.mjs reject",
    "reviews:unpublish": "node review-worker/scripts/moderate-reviews.mjs unpublish"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "cheerio": "1.0.0",
    "eta": "3.5.0",
    "fast-glob": "3.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
